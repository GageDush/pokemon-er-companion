{
  "name": "pokemon-er-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first companion app for Pokemon Elite Redux data, saves, teams, and legal recommendations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "set GITHUB_PAGES=1&& tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "data:inspect": "node scripts/run-python.mjs scripts/inspect_raw_sources.py",
    "data:generate": "node scripts/run-python.mjs scripts/extract_sources.py",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@tauri-apps/cli": "^2.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
